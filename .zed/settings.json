{
  "semantic_tokens": "combined",
  "prettier": {
    "allowed": false
  },
  "file_types": {
    "Shell Script": [".envrc*"],
    "TOML": [".sqlfluff"]
  },
  "lsp": {
    "oxlint": {
      "initialization_options": {
        "settings": {
          "configPath": null,
          "run": "onType",
          "disableNestedConfig": false,
          "fixKind": "safe_fix",
          "unusedDisableDirectives": "deny"
        }
      }
    },
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "fmt.configPath": null,
          "run": "onSave"
        }
      }
    },
    "nixd": {
      "settings": {
        "nixpkgs": {
          "expr": "(builtins.getFlake (builtins.toString ./.)).outputs.nixpkgs.${builtins.currentSystem}"
        },
        "formatting": {
          "command": ["nixfmt"]
        }
      }
    }
  },
  "languages": {
    "Go": {
      "format_on_save": "on",
      "language_servers": ["gopls"],
      "formatter": [{ "language_server": { "name": "gopls" } }]
    },
    "TypeScript": {
      "format_on_save": "on",
      "language_servers": ["typescript-ls", "oxlint", "tailwindcss-language-server", "oxfmt"],
      "formatter": [
        { "code_action": "source.fixAll.oxc" },
        { "language_server": { "name": "oxfmt" } }
      ]
    },
    "TSX": {
      "format_on_save": "on",
      "language_servers": ["typescript-ls", "oxlint", "tailwindcss-language-server", "oxfmt"],
      "formatter": [
        { "code_action": "source.fixAll.oxc" },
        { "language_server": { "name": "oxfmt" } }
      ]
    },
    "HTML": {
      "format_on_save": "on",
      "language_servers": ["oxfmt", "..."],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "CSS": {
      "format_on_save": "on",
      "language_servers": ["tailwindcss-language-server", "tailwindcss-intellisense-css", "oxfmt"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Proto": {
      "format_on_save": "on",
      "language_servers": ["buf"],
      "formatter": [{ "language_server": { "name": "buf" } }]
    },
    "Python": {
      "format_on_save": "on",
      "language_servers": ["pyright", "ruff"],
      "formatter": [
        { "code_action": "source.organizeImports.ruff" },
        { "code_action": "source.fixAll.ruff" },
        { "language_server": { "name": "ruff" } }
      ]
    },
    "SQL": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "sqlfluff",
          "arguments": ["format", "--stdin-filename", "{buffer_path}", "-"]
        }
      }
    },
    "Nix": {
      "format_on_save": "on",
      "language_servers": ["nixd"],
      "formatter": [{ "language_server": { "name": "nixd" } }]
    },
    "JSON": {
      "format_on_save": "on",
      "language_servers": ["json-language-server", "oxfmt"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "JSONC": {
      "format_on_save": "on",
      "language_servers": ["json-language-server", "oxfmt"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "YAML": {
      "format_on_save": "on",
      "language_servers": ["yaml-language-server", "oxfmt"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "TOML": {
      "format_on_save": "on",
      "language_servers": ["tombi", "oxfmt"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    },
    "Markdown": {
      "format_on_save": "on",
      "language_servers": ["oxfmt"],
      "formatter": [{ "language_server": { "name": "oxfmt" } }]
    }
  }
}
