{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "gopls": {
      "command": ["gopls"],
      "extensions": [".go"],
      "initialization": {
        "buildFlags": ["-tags=dev"]
      }
    },
    "typescript": {
      "command": ["tsc", "--lsp", "--stdio"],
      "extensions": [".ts", ".tsx"]
    },
    "oxlint": {
      "command": ["oxlint", "--lsp"]
    },
    "buf": {
      "command": ["buf", "lsp", "serve"],
      "extensions": [".proto"]
    },
    "sqls": {
      "command": ["sqls"],
      "extensions": [".sql"]
    },
    "json-ls": {
      "command": ["vscode-json-languageserver", "--stdio"],
      "extensions": [".json", ".jsonc"]
    },
    "yaml-ls": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yaml", ".yml"]
    },
    "tombi": {
      "command": ["tombi", "lsp"],
      "extensions": [".toml"]
    },
    "nixd": {
      "command": ["nixd"],
      "extensions": [".nix"]
    }
  }
}
