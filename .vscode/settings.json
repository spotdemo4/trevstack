{
  "files.associations": {
    "renovate.json": "jsonc",
    ".envrc*": "shellscript",
    ".sqlfluff": "toml",
    "*.css": "tailwindcss"
  },

  "editor.semanticHighlighting.enabled": true,

  "explorer.fileNesting.patterns": {
    ".envrc.project": ".envrc",
    "buf.yaml": "buf.gen.yaml,buf.lock",
    "flake.nix": "flake.lock,treefmt.toml",
    "README.md": "*.md,LICENSE",
    "package.json": "package-lock.json,.npmrc"
  },

  "json.schemaDownload.trustedDomains": {
    "https://raw.githubusercontent.com/": true,
    "https://docs.renovatebot.com/": true,
    "https://opencode.ai/": true,
    "https://models.dev/": true
  },

  "chat.tools.terminal.autoApprove": {
    // go
    "go run": true,
    "go mod tidy": true,

    // npm
    "npm run dev": true,
    "npm install": true,
    "npm update": true,
    "npm audit fix": true,

    // nix
    "nix build": true,
    "nix flake check": true
  },

  // golang.go
  "go.alternateTools": {
    "gopls": "gopls"
  },
  "go.buildTags": "dev",
  "gopls": { "ui.semanticTokens": true },
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },

  // TypeScriptTeam.native-preview
  "js/ts.experimental.useTsgo": true,

  // esbenp.prettier-vscode
  "prettier.enable": false,

  // oxc.oxc-vscode
  "oxc.enable.oxlint": true,
  "oxc.enable.oxfmt": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always" // oxlint
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[toml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },

  // bufbuild.vscode-buf
  "[proto]": {
    "editor.defaultFormatter": "bufbuild.vscode-buf"
  },

  // sqlfluff.vscode-sqlfluff
  "[sql]": {
    "editor.defaultFormatter": "sqlfluff.vscode-sqlfluff"
  },

  // redhat.vscode-yaml
  "yaml.format.enable": false,

  // jnoortheen.nix-ide
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "nixpkgs": {
        "expr": "(builtins.getFlake (builtins.toString ./.)).outputs.nixpkgs.${builtins.currentSystem}"
      },
      "formatting": {
        "command": ["nixfmt"]
      }
    }
  },
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide"
  }
}
