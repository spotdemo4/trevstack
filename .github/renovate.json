{
  "$schema": "https://docs.renovatebot.com/renovate-global-schema.json",

  // self-hosted
  "onboarding": false,
  "requireConfig": "ignored",
  "platform": "github",
  "repositories": ["spotdemo4/trevstack"],
  "allowedCommands": ["^nix run \\.#upgrade$", "^fix-hash \\.#packages\\.x86_64-linux\\.server$"],

  // repository
  "extends": ["config:recommended"],
  "addLabels": ["dep"],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* * * * 0"], // sunday
    "skipInstalls": false,
    "postUpgradeTasks": {
      "commands": ["nix run .#upgrade"],
      "executionMode": "branch"
    }
  },
  "customManagers": [
    {
      // track the go in nixpkgs-unstable, which builds this project
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)go\\.mod$/"],
      "matchStrings": ["toolchain\\s+go(?<currentValue>\\S+)"],
      "depNameTemplate": "go",
      "packageNameTemplate": "nix_unstable/go",
      "datasourceTemplate": "repology",
      "versioningTemplate": "semver"
    },
    {
      // track the rustc in nixpkgs-unstable, which builds this project
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Cargo\\.toml$/"],
      "matchStrings": ["rust-version\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "rust",
      "packageNameTemplate": "nix_unstable/rustc",
      "datasourceTemplate": "repology",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "matchManagers": ["nix"],
      "addLabels": ["nix"]
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["actions"]
    },
    {
      "matchManagers": ["gomod"],
      "addLabels": ["go"],
      "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
      "postUpgradeTasks": {
        "commands": ["fix-hash .#packages.x86_64-linux.server"],
        "executionMode": "branch"
      }
    },
    {
      // replaced by the nixpkgs-unstable custom manager
      "matchManagers": ["gomod"],
      "matchDepTypes": ["toolchain"],
      "enabled": false
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["go"],
      "addLabels": ["go"]
    },
    {
      "matchManagers": ["npm"],
      "addLabels": ["node"],
      "rangeStrategy": "bump",
      "postUpdateOptions": ["npmInstallTwice"]
    },
    {
      "matchManagers": ["cargo"],
      "addLabels": ["rust"]
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["rust"],
      "addLabels": ["rust"]
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "matchPackageNames": ["solid-js", "@solidjs/**"],
      "groupName": "solidjs"
    },
    {
      "matchPackageNames": ["@connectrpc/**", "connectrpc.com/**"],
      "groupName": "connectrpc"
    }
  ]
}
