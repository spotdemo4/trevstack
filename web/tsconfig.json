{
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "target": "ESNext",

    // Modules
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,

    // Type Checking & Safety
    "skipLibCheck": true,
    "strict": true,
    "types": ["vite/client", "node"],

    // Paths
    "paths": {
      "$connect/*": ["./connect/*"],
      "$lib/*": ["./lib/*"]
    }
  }
}
